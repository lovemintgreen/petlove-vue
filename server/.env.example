PORT=3000

# MySQL 資料庫設定
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=petlove_vue
DB_SSL=false

# JWT 認證設定（正式環境請務必換成 32 字元以上的隨機亂數）
JWT_SECRET=your_long_random_jwt_secret
JWT_EXPIRES_IN=7d

# 允許的前端來源（多個網域請以逗號分隔）
CORS_ORIGIN=http://localhost:5173

# Cloudinary 免費圖床設定（留空時自動退回本機 server/uploads/products/）
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=petlove/products
