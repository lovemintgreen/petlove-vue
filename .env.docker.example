# 複製此檔案為專案根目錄的 .env 後再執行 docker compose up -d --build
# cp .env.docker.example .env

# 對外 Web 埠號（預設 80；若搭配 docker-compose.https.yml 會由 Caddy 接管 80 / 443）
WEB_PORT=80

# 網域名稱（僅在使用 docker-compose.https.yml 啟用 HTTPS 時需要設定，例如 petlove.duckdns.org）
APP_DOMAIN=your-domain.duckdns.org

# MySQL 設定（請務必更換為強密碼）
DB_ROOT_PASSWORD=replace_with_strong_root_password
DB_NAME=petlove_vue
DB_USER=petlove
DB_PASSWORD=replace_with_strong_db_password

# JWT 設定（建議以 openssl rand -hex 32 產生 64 字元隨機字串）
JWT_SECRET=replace_with_64_char_random_hex_secret
JWT_EXPIRES_IN=7d

# CORS 允許來源（同源部署透過 Nginx /api 可填正式網址，多個請以逗號分隔）
CORS_ORIGIN=http://localhost,https://your-domain.duckdns.org

# Cloudinary 免費圖床憑證（於 Cloudinary Dashboard 取得；留空則退回容器 Volume 本機儲存）
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=petlove/products
